@model CriarContaModelo
@{
    ViewData["Titulo"] = T[Textos.Conta_CriarConta];
    var erro = ViewData["Erro"] as string;
}
<section class="tela-publica">
  <div class="logo">@T[Textos.Comum_NomeDoJogo]<small>@T[Textos.Comum_Slogan]</small></div>
  <div class="painel">
    <h1>@T[Textos.Conta_CriarConta]</h1>
    @if (erro is not null)
    {
      <p class="erro" role="alert">@T[erro]</p>
    }
    <form method="post" asp-controller="Conta" asp-action="Criar">
      <label for="apelido">@T[Textos.Conta_Apelido]</label>
      <input id="apelido" name="Apelido" maxlength="16" required value="@Model.Apelido" autocomplete="nickname">
      <label for="email">@T[Textos.Conta_Email]</label>
      <input id="email" name="Email" type="email" required value="@Model.Email" autocomplete="email">
      <label for="senha">@T[Textos.Conta_Senha]</label>
      <input id="senha" name="Senha" type="password" minlength="10" required autocomplete="new-password" aria-describedby="dica-senha">
      <p id="dica-senha" class="nota">@T[Textos.Conta_SenhaDica]</p>
      <label class="marcador"><input type="checkbox" name="AceitoTermos" value="true" required> @T[Textos.Conta_AceitoTermos]</label>
      <label class="marcador"><input type="checkbox" name="DeclaroMaioridade" value="true" required> @T[Textos.Conta_DeclaroMaioridade]</label>
      <button class="btn largo" type="submit">@T[Textos.Conta_CriarConta]</button>
    </form>
    <p class="links"><a href="/conta/entrar">@T[Textos.Conta_JaTenhoConta]</a></p>
  </div>
</section>
